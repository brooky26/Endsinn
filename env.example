# ── Deriv API ────────────────────────────────────────────────────────────
# Your Deriv application ID (from https://api.deriv.com/dashboard/#/)
DERIV_APP_ID=
# Deriv API token (create at https://app.deriv.com/account/api-token)
DERIV_API_TOKEN=
# "demo" or "real" -- which account type the bot should trade on
DERIV_ACCOUNT_TYPE=demo
# Optional: force a specific account_id instead of auto-resolving by type
DERIV_ACCOUNT_ID=

# ── Supabase ─────────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxx.supabase.co
SUPABASE_URL=
# Use the SERVICE ROLE key (not anon) -- the bot inserts/upserts directly
# via PostgREST and needs to bypass row-level security.
SUPABASE_KEY=
